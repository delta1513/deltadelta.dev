<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }} - Delta's Blog</title>
    <link href="/dist/output.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Jockey+One&family=Rubik&display=swap" rel="stylesheet">
</head>
<body class="bg-gradient-to-b from-page-bg-start to-page-bg min-h-screen font-rubik">
    <header class="container mx-auto px-4 py-16 text-center">
        <h1 class="text-5xl font-bold text-neon-green mb-4 font-jockey">{{ title }}</h1>
    </header>

    <main class="container mx-auto px-4 max-w-4xl">
        <article class="prose prose-invert prose-lg mx-auto">
            {{ content | safe }}
        </article>
    </main>

    <footer class="container mx-auto px-4 py-8 text-center text-gray-300">
        <div class="space-x-4">
            <a href="/" class="text-neon-green hover:text-neon-green-accent">← Back to Home</a>
            <a href="/blog" class="text-neon-green hover:text-neon-green-accent">Blog Index</a>
        </div>
    </footer>
</body>
</html> 