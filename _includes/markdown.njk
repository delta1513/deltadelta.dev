<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <link rel="icon" href="/favicon.png" type="image/png">
  <style>
    :root {
      --bg: #fbfbf9;          /* near-white */
      --fg: #4a4a48;          /* de-saturated black/grey */
      --muted: #8a8780;       /* subtitles, captions */
      --border: #000000;      /* solid black window border */
      --line: #d8d4ca;        /* rules, code bg edges */
      --code-bg: #efeee9;     /* code background */
      --hover: #0000ee;       /* traditional hyperlink blue */
    }
    * { box-sizing: border-box; }
    body {
      background: var(--bg);
      color: var(--fg);
      font-family: ui-monospace, "SF Mono", Menlo, Consolas, "Courier New", monospace;
      font-size: 15px;
      line-height: 1.7;
      margin: 0;
      padding: 1.5rem 1rem;
    }
    main {
      max-width: 760px;
      margin: 0 auto;
      border: 2px solid var(--border);
      padding: 1.5rem 1.75rem;
    }

    .post-head { margin-bottom: 1.75rem; }
    h1 { font-size: 2.25em; line-height: 1.3; margin: 0 0 0.4rem; }
    .description { color: var(--muted); font-style: italic; margin: 0; }
    .post-date { color: var(--muted); font-size: 0.85em; margin: 0.25rem 0 0; }

    /* links: blue, underline on hover — same interaction as the directory tree */
    a { color: var(--hover); text-decoration: none; }
    a:hover { text-decoration: underline; }

    h2, h3, h4 { line-height: 1.3; margin: 2rem 0 0.5rem; }
    p, ul, ol, blockquote, pre, table { margin: 1rem 0; }
    ul, ol { padding-left: 1.5rem; }
    li { margin: 0.25rem 0; }

    img { max-width: 100%; height: auto; display: block; margin: 1.25rem auto; border: 1px solid var(--line); }

    blockquote {
      margin-left: 0;
      padding-left: 1rem;
      border-left: 3px solid var(--line);
      color: var(--muted);
    }

    hr { border: none; border-top: 1px solid var(--line); margin: 2rem 0; }

    .home-link,
    .home-link:hover,
    .home-link:visited,
    .home-link:active { display: block; max-width: 760px; margin: 1rem auto; color: var(--fg); font-weight: bold; text-decoration: underline; }

    code { background: var(--code-bg); padding: 0.1em 0.35em; border-radius: 2px; font-size: 0.9em; }
    pre { background: var(--code-bg); padding: 1rem; overflow-x: auto; border: 1px solid var(--line); }
    pre code { background: none; padding: 0; font-size: 0.85em; }

    table { border-collapse: collapse; width: 100%; }
    th, td { border: 1px solid var(--line); padding: 0.4rem 0.6rem; text-align: left; }
  </style>
</head>
<body id="top">
  <a class="home-link" href="/">&larr; Home</a>
  <main>
    <header class="post-head">
      <h1 style="font-size: 2.75em;text-decoration: underline;">{{ title }}</h1>
      {% if description %}<p class="description">{{ description }}</p>{% endif %}
      {% if date %}<p class="post-date">{{ date | dateFormat }}</p>{% endif %}
    </header>
    {{ content | safe }}
  </main>
  <a class="home-link" href="#top">&uarr; Back to top</a>
</body>
</html>
