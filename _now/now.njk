---
layout: base.njk
---

<div class="timeline-container max-w-2xl mx-auto px-4 py-8">
  <div class="relative">
    <!-- Vertical line -->
    <div class="absolute left-1/4 transform -translate-x-1/6 sm:-translate-x-1/4 h-full w-1 bg-gradient-to-b from-neon-green to-neon-green-accent"></div>

    {%- for post in collections.posts | reverse -%}
      <div class="timeline-item relative mb-8">
        <!-- Content bubble -->
        <div class="bg-gradient-to-bl from-neon-green to-neon-green-accent rounded-lg p-1 ml-[calc(12.5%+2rem)] sm:ml-[calc(25%+2rem)] w-[calc(75%-2rem)] sm:w-[calc(50%-2rem)]">
          <div class="bg-button-purple rounded-lg p-4 prose prose-invert">
            <p class="text-neon-green text-sm">{{ post.date | dateFormat }}</p>
            <div class="text-gray-300">{{ post.content | safe }}</div>
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

<style>
  .timeline-item:last-child .timeline-line {
    display: none;
  }
</style>