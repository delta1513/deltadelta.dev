#!/bin/sh
# Ensure build artifacts are up-to-date and committed alongside source changes.

echo "Running npm run build to verify build artifacts are current..."
npm run build > /tmp/pre-commit-build.log 2>&1
if [ $? -ne 0 ]; then
    echo "error: 'npm run build' failed. See output below:" >&2
    cat /tmp/pre-commit-build.log >&2
    exit 1
fi

if ! git diff --quiet; then
    echo "error: 'npm run build' produced changes that are not staged for commit." >&2
    echo "The following build artifacts are out of date:" >&2
    git diff --stat >&2
    echo "" >&2
    echo "Run 'npm run build', then 'git add' the updated files, and commit again." >&2
    exit 1
fi

exit 0
