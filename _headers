# Browser caching rules, applied by Cloudflare Workers static assets.
# Where several rules match a URL, their headers are merged.

# Pages: never cache the homepage or any blog page.
/
  Cache-Control: no-store
/index.html
  Cache-Control: no-store
/blog
  Cache-Control: no-store
/blog/*
  Cache-Control: no-store
/llms.txt
  Cache-Control: no-store
  Content-Type: text/plain; charset=utf-8
/robots.txt
  Content-Type: text/plain; charset=utf-8

# Static media: cache for 30 days (2592000s) at most.
/*.png
  Cache-Control: public, max-age=2592000
/*.jpg
  Cache-Control: public, max-age=2592000
/*.jpeg
  Cache-Control: public, max-age=2592000
/*.gif
  Cache-Control: public, max-age=2592000
/*.mp4
  Cache-Control: public, max-age=2592000
/*.webm
  Cache-Control: public, max-age=2592000
